{
  "checkCmd": "(checkupdates; paru -Qua) 2>/dev/null",
  "updateCmd": "kitty --title 'System update' --class 'system-update' -e 'system-update'",
  "flatpak": true,
  "noctalia": true,
  "toast": true,
  "desktopTip": true,
  "hideOnEmpty": true,
  "refreshTimer": true,
  "refreshInterval": 120,
  "iconName": "arrow-big-down-lines",
  "useDistroLogo": true,
  "customIconPath": "",
  "boldText": true,
  "enableColorization": true,
  "iconColor": "tertiary",
  "boldVer": true,
  "tooltip": true,
  "closeButton": false,
  "nameCmd": "(checkupdates; paru -Qua;) | awk '{print $1}'",
  "oldVerCmd": "(checkupdates; paru -Qua;) | awk '{print $2}'",
  "newVerCmd": "(checkupdates; paru -Qua;) | awk '{print $4}'"
}

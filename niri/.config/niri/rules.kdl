layer-rule {
    match namespace="^noctalia-overview*"
    place-within-backdrop true
}

window-rule {
    match app-id="^kitty$"
    match app-id="^Alacritty$"
    match app-id="^btop$"

    background-effect {
        xray true
        blur true
    }

    opacity 0.95
}

window-rule {
    match app-id="^kitty$" is-focused=true
    match app-id="^Alacritty$" is-focused=true
    match app-id="^btop$" is-focused=true

    background-effect {
        xray true
        blur true
    }

    opacity 1.0
}

window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#

    block-out-from "screen-capture"
}

window-rule {
    match app-id="^zen$"
    match app-id="^steam$"

    open-maximized true
}

window-rule {
    match app-id="^gamescope$"

    open-fullscreen true
}

window-rule {
    match app-id="^blender$"
    match app-id="^org.inkscape.Inkscape$"
    match app-id="^gimp$"

    open-maximized true
    open-maximized-to-edges false
}

window-rule {
    match app-id="^zen$" title="^Picture-in-Picture$"
    match app-id="^zen$" title="Extension: .*"
    match app-id="^PortProton$"
    match app-id="^org.kde.kdeconnect.daemon"
    match app-id="^com.saivert.pwvucontrol$"
    match app-id="^blueman-manager$"
    match app-id="^org.gnome.NautilusPreviewer$"
    match app-id="^app.drey.Dialect$"
    match app-id="^system-update$"
    match app-id="^cache-cleaning$"
    match title="^ballin$"

    exclude app-id="^dev.zed.Zed$"

    open-floating true
}

window-rule {
    match app-id="^btop$"

    open-floating true

    min-width 1200
    min-height 900

    default-floating-position x=8 y=8 relative-to="top-left"
    geometry-corner-radius 11
}

window-rule {
    match app-id="^zen$" title="^Picture-in-Picture$"

    min-width 500
    max-width 500

    min-height 281
    max-height 281

    background-effect {
        xray false
        blur false
    }

    opacity 1.0

    default-floating-position x=8 y=8 relative-to="bottom-right"
    geometry-corner-radius 11
}

window-rule {
    match app-id="^Spotify$"
    match app-id="^dev.zed.Zed$"
    match app-id="^org.telegram.desktop$"
    match app-id="^anytype$"
    match app-id="^audacity$"
    match app-id="^vesktop$"
    match app-id="^com.obsproject.Studio$"

    default-column-width {
        proportion 0.75
    }
}

window-rule {
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#

    border {
        off
    }

    focus-ring {
        off
    }

    geometry-corner-radius 0
    default-floating-position x=0 y=0 relative-to="bottom-right"
    open-focused false
}

debug {
  // Allows notification actions and window activation from Noctalia.
  honor-xdg-activation-with-invalid-serial
}
